{
  "schema": "frozen_external_scope_cases_v1",
  "status": "frozen_before_projected_spectrum_integration",
  "case_count": 23,
  "purpose": "Fixed acceptance set for scope-correct projected/azimuthal spectra, with independent published compatibility controls.",
  "frozen_policy": {
    "no_post_result_deletions": true,
    "no_reference_changes_to_fit_solver": true,
    "all_unsupported_failed_open_cases_reported": true,
    "amendment_policy": "Any transcription correction requires a dated explicit erratum; retain original references and failure history."
  },
  "common_semantics": {
    "mean_zero": "Closed quadratic-form compression to the orthogonal complement of the constant spherical harmonic, not deletion of the perturbed operator ground eigenpair.",
    "axisymmetric_mean_zero": "m=0 with unperturbed l=0 removed; l>=1 basis.",
    "full_sphere_mean_zero": "m=0 compressed sector plus every ordinary |m|>=1 sector; prove or bound the omitted azimuthal tail.",
    "fixed_azimuthal_m": "Regular endpoint realization of -d/dt((1-t^2)d/dt)+m^2/(1-t^2)+q(t), with l>=|m|.",
    "indexing": "All API-independent eigenvalue indices are 1-based within the explicitly named space.",
    "sphere_warning": "The angular equation matches a unit-S2 Schrödinger operator; this does not transplant the paper radial spheroidal-well geometry into the test."
  },
  "acceptance_policy": {
    "scope_and_index_must_match": true,
    "proof_replay_required": true,
    "finite_decimal_check": "Certified interval must intersect [reference-radius,reference+radius] and satisfy requested interval-width budget. This is compatibility, not proof from a table.",
    "exact_check": "The exact reference must be contained in the certified interval; requested width still applies.",
    "coarse_check": "E19 certificate must be consistent with [6,44/7] and reach the same width budget. Its tight center is not supplied as an external reference.",
    "semantic_relation_check": "Apply R1-R4 in addition to per-case conditions; equality of two values does not merge their operator scopes.",
    "no_open_problem_claim": true
  },
  "sources": [
    {
      "id": "USOV_2023_V1",
      "type": "primary_research_paper",
      "title": "N. A. Usov, Spheroidal quantum well",
      "url": "https://arxiv.org/pdf/2307.04124v1",
      "locations": [
        "Equation (7a), PDF page 2",
        "Equations (12a)-(12b), PDF pages 2-3",
        "index convention and Tables 1a-1c, PDF page 5"
      ],
      "equation": "d/dt((1-t^2)dS/dt)+(Lambda-c^2*t^2-m^2/(1-t^2))*S=0",
      "indexing": "l=|m|,|m|+1,...; k=l-|m|+1; number of interior zeros=l-|m|",
      "precision_note": "Author supplies finite decimals and states ten-digit precision. No rigorous error interval is supplied; fixed comparison radius is an engineering compatibility tolerance only.",
      "retrieval_note": "PDF extracted text was read; the web screenshot service was unavailable. Equations are cross-checked against DLMF after the explicit eigenvalue shift."
    },
    {
      "id": "DLMF_30_2",
      "type": "official_primary_reference",
      "title": "NIST DLMF 30.2, Spheroidal Differential Equation",
      "url": "https://dlmf.nist.gov/30.2",
      "equation": "d/dt((1-t^2)dw/dt)+(lambda_DLMF+gamma^2*(1-t^2)-m^2/(1-t^2))*w=0",
      "conversion": "For q=+c^2*t^2 and gamma^2=c^2, Lambda=lambda_DLMF+c^2. No sign flip; no comparison before this shift."
    },
    {
      "id": "DLMF_30_3_ZERO",
      "type": "official_primary_reference",
      "title": "NIST DLMF 30.3, Eigenvalues; equation 30.3.3",
      "url": "https://dlmf.nist.gov/30.3",
      "zero_parameter_formula": "lambda_l^m(0)=l(l+1), l>=m; regular endpoint solution behaves as (1-t^2)^(m/2) times an analytic factor."
    },
    {
      "id": "AUDIT_LINEAR_80",
      "type": "independent_audit_calculation_not_external_source",
      "method": "Before using projected_spectrum, standard-library float Sturm bisection on an independently assembled 80x80 symmetric tridiagonal Legendre matrix.",
      "diagonal": "l(l+1)",
      "off_diagonal_squared": "a^2*((l+1)^2-m^2)/((2*l+1)*(2*l+3))",
      "ordinary_start_l": 0,
      "m0_projected_start_l": 1,
      "m1_start_l": 1,
      "bisection_steps": 120,
      "initial_bracket": "[-abs(a)-1, last_l*(last_l+1)+abs(a)+1]",
      "limitations": "Finite-section and floating arithmetic errors were not certified. These numbers are compatibility controls, not published external references and not proofs.",
      "supplementary_m1_values": {
        "a=1": "1.950333905229143",
        "a=4": "1.269853707869948"
      }
    },
    {
      "id": "AUDIT_M2_RAYLEIGH",
      "type": "independent_exact_derivation",
      "derivation": "q>=0 gives Lambda>=m(m+1)=6. For S=(1-t^2), weighted average t^2 with S^2 is 1/7, so Lambda<=6+2/7."
    },
    {
      "id": "AUDIT_BRANCH_SELECTION",
      "type": "independent_exact_derivation",
      "linear_potential": "After a sign gauge, the q=a*t Jacobi off-diagonal entries are nonpositive. Their magnitudes for m=0,l>=1 dominate those in every m>=1 branch, embedded in l>=1. Taking absolute coefficients gives full mean-zero ground equal to m0-compressed ground.",
      "quadratic_potential": "For q=2t^2, the m0-compressed P1 diagonal is 16/5, the l>=2 tail is >=6, and the squared P1-tail coupling is 48/175. At Lambda=3 the Schur bound is (1/5)*3-48/175>0, hence m0 projection>=3. Every |m|>=2 branch>=6, while the m=1,l=1 Rayleigh bound is 2+2/5=12/5. Thus the full mean-zero ground lies in |m|=1."
    },
    {
      "id": "AUDIT_SCOPE_SEPARATION",
      "type": "predeclared_independent_scope_test",
      "claim": "q=t+t^2: full mean-zero ground < m0 mean-zero compression ground < ordinary axisymmetric second eigenvalue. Requested independently before this benchmark; compare certified intervals, not matching scope names."
    }
  ],
